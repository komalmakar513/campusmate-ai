# Azure AI multi-service key + endpoint (leave empty = Demo Mode, works offline)
AI_ENDPOINT=https://<your-name>.cognitiveservices.azure.com
AI_KEY=
AI_REGION=centralindia

# Optional Translator-specific settings. If the key is blank, AI_KEY is reused.
# The region must match the Azure Translator resource.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
